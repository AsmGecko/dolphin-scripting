# The same for every editor: UTF-8 without BOM, LF, a newline at the end, no trailing spaces
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,c,h,sh,md}]
max_line_length = 120

[*.{py,c,h}]
indent_style = space
indent_size = 4

[*.sh]
indent_style = space
indent_size = 2
