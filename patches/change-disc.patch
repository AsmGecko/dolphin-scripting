+// Ejects the disc and inserts this one a second later, as File > Change Disc does
+static void EmulationChangeDisc(PyObject* self, const char* path)
+{
+  EmulationModuleState* state = Py::GetState<EmulationModuleState>(self);
+  const Core::CPUThreadGuard guard(*state->system);
+  state->system->GetDVDInterface().ChangeDisc(guard, path);
+}
