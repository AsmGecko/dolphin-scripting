diff --git a/Source/Core/Core/HW/EXI/EXI_DeviceSD.cpp b/Source/Core/Core/HW/EXI/EXI_DeviceSD.cpp
new file mode 100644
index 0000000..928c74b
--- /dev/null
+++ b/Source/Core/Core/HW/EXI/EXI_DeviceSD.cpp
@@ -0,0 +1,134 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "Core/HW/EXI/EXI_DeviceSD.h"
+
+#include <array>
+
+#include "Common/FileUtil.h"
+
+namespace ExpansionInterface
+{
+CEXISD::CEXISD(Core::System& system)
+    : IEXIDevice(system), m_image(File::GetUserPath(D_LOAD_IDX) + "GCSD.img", "rb")
+{
+}
+
+void CEXISD::SetCS(int cs)
+{
+  if (!cs)
+    m_command.clear();
+}
+
+static u16 CRC16(const u8* data, size_t length)
+{
+  u16 crc = 0;
+  for (size_t i = 0; i < length; ++i)
+  {
+    crc ^= data[i] << 8;
+    for (int bit = 0; bit < 8; ++bit)
+      crc = crc & 0x8000 ? (crc << 1) ^ 0x1021 : crc << 1;
+  }
+  return crc;
+}
+
+void CEXISD::QueueBlock()
+{
+  std::array<u8, 512> block{};
+  m_image.Seek(u64{m_next} * 512, File::SeekOrigin::Begin);
+  m_image.ReadBytes(block.data(), block.size());
+  m_image.ClearError();
+  ++m_next;
+  m_out.push_back(0xFF);
+  m_out.push_back(0xFE);
+  m_out.insert(m_out.end(), block.begin(), block.end());
+  const u16 crc = CRC16(block.data(), block.size());
+  m_out.push_back(crc >> 8);
+  m_out.push_back(crc & 0xFF);
+}
+
+void CEXISD::Execute()
+{
+  const u8 command = m_command[0] & 0x3F;
+  const u32 argument = m_command[1] << 24 | m_command[2] << 16 | m_command[3] << 8 | m_command[4];
+  const bool app = m_app;
+  m_app = false;
+  const u8 idle = m_ready ? 0 : 1;
+  m_out.push_back(0xFF);
+  if (command == 12)
+  {
+    m_streaming = false;
+    m_out.clear();
+    m_out.insert(m_out.end(), {0xFF, 0x00, 0x00, 0x00});
+    return;
+  }
+  if (app && command == 41)
+  {
+    m_ready = ++m_starts >= 3;
+    m_out.push_back(m_ready ? 0 : 1);
+    return;
+  }
+  switch (command)
+  {
+  case 0:
+    m_ready = false;
+    m_starts = 0;
+    m_streaming = false;
+    m_out.push_back(0x01);
+    break;
+  case 8:
+    m_out.insert(m_out.end(), {idle, 0x00, 0x00, static_cast<u8>(argument >> 8 & 0xF),
+                               static_cast<u8>(argument & 0xFF)});
+    break;
+  case 55:
+    m_app = true;
+    m_out.push_back(idle);
+    break;
+  case 58:
+    m_out.insert(m_out.end(), {idle, static_cast<u8>(m_ready ? 0xC0 : 0x00), 0xFF, 0x80, 0x00});
+    break;
+  case 16:
+  case 59:
+    m_out.push_back(idle);
+    break;
+  case 17:
+  case 18:
+    if (!m_ready)
+    {
+      m_out.push_back(0x04);
+      break;
+    }
+    m_out.push_back(0x00);
+    m_next = argument;
+    QueueBlock();
+    m_streaming = command == 18;
+    break;
+  default:
+    m_out.push_back(idle | 0x04);
+    break;
+  }
+}
+
+void CEXISD::TransferByte(u8& byte)
+{
+  const u8 in = byte;
+  if (m_out.empty() && m_streaming)
+    QueueBlock();
+  if (m_out.empty())
+  {
+    byte = 0xFF;
+  }
+  else
+  {
+    byte = m_out.front();
+    m_out.pop_front();
+  }
+  if (m_command.empty() && (in & 0xC0) != 0x40)
+    return;
+  m_command.push_back(in);
+  if (m_command.size() == 6)
+  {
+    Execute();
+    m_command.clear();
+  }
+}
+}  // namespace ExpansionInterface
diff --git a/Source/Core/Core/HW/EXI/EXI_DeviceSD.h b/Source/Core/Core/HW/EXI/EXI_DeviceSD.h
new file mode 100644
index 0000000..642be6d
--- /dev/null
+++ b/Source/Core/Core/HW/EXI/EXI_DeviceSD.h
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <deque>
+#include <vector>
+
+#include "Common/CommonTypes.h"
+#include "Common/IOFile.h"
+#include "Core/HW/EXI/EXI_Device.h"
+
+namespace ExpansionInterface
+{
+// An SDHC card in SPI mode, as on an SD Gecko or SD2SP2, read-only, backed by Load/GCSD.img in the user folder
+class CEXISD final : public IEXIDevice
+{
+public:
+  explicit CEXISD(Core::System& system);
+  bool IsPresent() const override { return true; }
+  void SetCS(int cs) override;
+
+private:
+  void TransferByte(u8& byte) override;
+  void Execute();
+  void QueueBlock();
+
+  File::IOFile m_image;
+  std::vector<u8> m_command;
+  std::deque<u8> m_out;
+  bool m_app = false;
+  bool m_ready = false;
+  bool m_streaming = false;
+  int m_starts = 0;
+  u32 m_next = 0;
+};
+}  // namespace ExpansionInterface
